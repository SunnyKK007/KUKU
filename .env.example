# Copy to .env and fill ONE key. All are free tiers. Tools pick the first key found,
# or set LLM_MODEL to force one, e.g. LLM_MODEL=gemini:gemini-2.5-flash
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For any other OpenAI-compatible endpoint (e.g. one Kuku provides at interview):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional, Problem 2 voice input in Indian languages
SARVAM_API_KEY=
